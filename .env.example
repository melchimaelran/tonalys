# IMPORTANT — Docker Compose interpolates $xxx inside .env values (even
# mid-string). Any literal $ in a value (e.g. a bcrypt hash: $2b$10$...)
# MUST be escaped as $$, or Compose silently corrupts it (blank string,
# no error) — see AUTH_PASSWORD_HASH below and ADR-025.

POSTGRES_USER=tonalys
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tonalys

RABBITMQ_USER=tonalys
RABBITMQ_PASSWORD=changeme

MINIO_ROOT_USER=tonalys
MINIO_ROOT_PASSWORD=changeme12345

JWT_SECRET=changeme
# bcrypt hash — escape every literal $ as $$ (Docker Compose interpolates
# $xxx in .env values otherwise, corrupting the hash)
AUTH_PASSWORD_HASH=changeme

# server-side only (Route Handlers) — never exposed to the browser
NEST_API_URL=http://localhost:3001