# Reverse proxy + automatic HTTPS for the production stack.
# Caddy fetches and renews a Let's Encrypt certificate for this domain on
# its own, as long as ports 80 and 443 are reachable from the internet and
# the DNS A record points here.

tonalys.melchimael.dev {
	encode zstd gzip

	# Audio uploads go through the Next.js route handler, which streams
	# them to nest. Raise the body limit well above a typical song.
	request_body {
		max_size 100MB
	}

	reverse_proxy next:3000
}
