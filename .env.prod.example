# Production env for the VPS — copy to /opt/tonalys/.env and fill in real
# secrets. NEVER commit the filled-in .env (gitignored).
#
# Docker Compose interpolates $xxx inside .env values (even mid-string).
# Any literal $ in a value (e.g. a bcrypt hash: $2b$10$...) MUST be
# escaped as $$ — see AUTH_PASSWORD_HASH below and ADR-025.

# --- Postgres ---
POSTGRES_USER=tonalys
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=tonalys

# --- RabbitMQ ---
RABBITMQ_USER=tonalys
RABBITMQ_PASSWORD=CHANGE_ME_long_random

# --- MinIO (password min 8 chars) ---
MINIO_ROOT_USER=tonalys
MINIO_ROOT_PASSWORD=CHANGE_ME_long_random

# --- Auth ---
# JWT_SECRET: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# AUTH_PASSWORD_HASH: bcrypt hash of your login password.
#   node -e "console.log(require('bcrypt').hashSync(process.argv[1],10))" 'yourpassword'
# then replace every literal $ with $$ before pasting here.
AUTH_PASSWORD_HASH=CHANGE_ME_bcrypt_hash_with_$$_escaped
# "true" keeps the login wall (only /login + /about public).
# "false" opens every route with no login + a small app-wide daily cap.
AUTH_ENABLED=true

# --- Housekeeping ---
# Non-demo tracks older than this (hours) are deleted (DB + MinIO) by the
# daily cleanup cron.
TRACK_RETENTION_HOURS=24

# --- Image tag deployed ---
# The deploy workflow overrides this per-run with the commit SHA.
# Left here so a bare `docker compose -f docker-compose.prod.yml up -d`
# still resolves. Set to a past SHA to roll back manually.
IMAGE_TAG=latest
