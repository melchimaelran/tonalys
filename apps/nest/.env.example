# Native-dev config for the Nest API — copy to `.env` and fill in.
# (For the full Docker stack, use the root `.env.example` instead.)

DATABASE_URL=postgresql://tonalys:changeme@localhost:5432/tonalys
PORT=3001

# 16+ chars. Generate one: `openssl rand -hex 32`
JWT_SECRET=changeme-use-a-long-random-string
# bcrypt hash of your login password: `node -e "console.log(require('bcrypt').hashSync('yourpassword',10))"`
AUTH_PASSWORD_HASH=changeme

# "false" opens every route with no login (temporary public access).
AUTH_ENABLED=true
# Non-demo tracks older than this (hours) are deleted (DB + MinIO) by the
# daily cleanup cron.
TRACK_RETENTION_HOURS=24

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=tonalys
MINIO_ROOT_PASSWORD=changeme12345
MINIO_BUCKET=tracks

RABBITMQ_URL=amqp://tonalys:changeme@localhost:5672
WORKER_URL=http://localhost:8000
