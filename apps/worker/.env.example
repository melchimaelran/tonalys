# Native-dev config for the analysis worker — copy to `.env`.
# Same credentials as apps/nest/.env (the worker writes to the same
# Postgres tables and MinIO bucket).

RABBITMQ_URL=amqp://tonalys:changeme@localhost:5672
DATABASE_URL=postgresql://tonalys:changeme@localhost:5432/tonalys

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=tonalys
MINIO_ROOT_PASSWORD=changeme12345
MINIO_BUCKET=tracks

# Path to a Netscape-format cookies.txt for yt-dlp. Leave unset in dev
# (residential IP needs no cookies). Prod runs from a datacenter IP that
# YouTube bot-checks — set this to a cookies file exported from a
# logged-in throwaway Google account. See docs/deployment.md.
# YT_COOKIES_FILE=/data/yt-cookies.txt

# Base URL of the bgutil PO-token provider (yt-dlp plugin picks it up).
# Leave unset in dev. Prod: the pot-provider sidecar, see
# docker-compose.prod.yml / docs/deployment.md.
# BGUTIL_POT_BASE_URL=http://pot-provider:4416
