# Native-dev config for the frontend — copy to `.env.local`.
# Next.js does NOT read the repo-root .env; it only loads apps/next/.env*.

# Where the Route Handlers reach the Nest API (server-side only).
NEST_API_URL=http://localhost:3001

# Keep in sync with apps/nest/.env's AUTH_ENABLED. "false" opens every
# route with no login. Read server-side only (proxy.ts, resolveApiAuth).
AUTH_ENABLED=true
